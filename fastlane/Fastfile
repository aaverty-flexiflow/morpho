BUNDLE_ID = "fr.flexiflow.morpho"
TEAM_ID   = "L6AURMZGGS"
ROOT      = File.expand_path('..', __dir__)

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────

# In CI, build number = $FLUTTER_BUILD_NUMBER (GitHub run number).
# Locally, we increment the number stored in pubspec.yaml.
def resolve_build_number
  if ENV["FLUTTER_BUILD_NUMBER"]
    return ENV["FLUTTER_BUILD_NUMBER"].to_i
  end

  pubspec_path = File.join(ROOT, "pubspec.yaml")
  pubspec      = File.read(pubspec_path)
  m            = pubspec.match(/^version:\s+(\d+\.\d+\.\d+)\+(\d+)/)
  new_build    = m[2].to_i + 1

  File.write(pubspec_path, pubspec.sub(/^version:\s+\S+/, "version: #{m[1]}+#{new_build}"))
  git_commit(path: "pubspec.yaml", message: "chore: bump build to #{new_build} [skip ci]") rescue nil

  UI.success("📦 #{m[1]}+#{new_build}")
  new_build
end

def version_name
  File.read(File.join(ROOT, "pubspec.yaml")).match(/^version:\s+(\d+\.\d+\.\d+)/)[1]
end

def asc_api_key
  require 'base64'

  params = {
    key_id:   ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    in_house: false,
  }

  # CI: use base64 key content (avoids LibreSSL "invalid curve name" on macOS runners).
  # Local: fall back to key file path.
  if ENV["ASC_KEY_CONTENT"]
    params[:key_content] = Base64.decode64(ENV.fetch("ASC_KEY_CONTENT"))
  else
    params[:key_filepath] = ENV.fetch("ASC_KEY_PATH")
  end

  app_store_connect_api_key(**params)
end

# Writes ios/ExportOptions.plist with explicit profile mapping for app + widget.
# Flutter passes this to xcodebuild so both targets are signed correctly.
def write_export_options
  main_profile   = ENV["sigh_#{BUNDLE_ID}_appstore_profile-name"]   || "match AppStore #{BUNDLE_ID}"
  widget_profile = ENV["sigh_#{BUNDLE_ID}.MorphoWidget_appstore_profile-name"] || "match AppStore #{BUNDLE_ID}.MorphoWidget"

  plist = <<~PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
        <key>method</key>
        <string>app-store</string>
        <key>teamID</key>
        <string>#{TEAM_ID}</string>
        <key>uploadSymbols</key>
        <true/>
        <key>provisioningProfiles</key>
        <dict>
            <key>#{BUNDLE_ID}</key>
            <string>#{main_profile}</string>
            <key>#{BUNDLE_ID}.MorphoWidget</key>
            <string>#{widget_profile}</string>
        </dict>
    </dict>
    </plist>
  PLIST

  path = File.join(ROOT, "ios", "ExportOptions.plist")
  File.write(path, plist)
  UI.message("ExportOptions.plist written → #{path}")
  path
end

# Forces Xcode to use manual signing with the Match profiles for both targets.
def setup_signing
  [
    { target: "Runner",       bundle_id: BUNDLE_ID },
    { target: "MorphoWidget", bundle_id: "#{BUNDLE_ID}.MorphoWidget" },
  ].each do |t|
    profile_env_key = "sigh_#{t[:bundle_id]}_appstore_profile-name"
    profile_name    = ENV[profile_env_key]
    next unless profile_name

    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "ios/Runner.xcodeproj",
      team_id:               TEAM_ID,
      code_sign_identity:    "Apple Distribution",
      targets:               [t[:target]],
      profile_name:          profile_name,
    )
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# iOS
# ─────────────────────────────────────────────────────────────────────────────

platform :ios do

  desc "Sync signing certificates and profiles (run once to bootstrap)"
  lane :certificates do
    match(
      type:           "appstore",
      api_key:        asc_api_key,
      app_identifier: [BUNDLE_ID, "#{BUNDLE_ID}.MorphoWidget"],
      readonly:       false,
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci if is_ci

    build_num = resolve_build_number

    match(
      type:           "appstore",
      api_key:        asc_api_key,
      app_identifier: [BUNDLE_ID, "#{BUNDLE_ID}.MorphoWidget"],
      readonly:       is_ci,
    )

    # Force manual signing so Xcode uses the Match profiles instead of auto-signing
    setup_signing
    plist = write_export_options

    sh "flutter build ipa --release --export-options-plist='#{plist}' --build-number=#{build_num}"

    pilot(
      api_key:                           asc_api_key,
      app_identifier:                    BUNDLE_ID,
      ipa:                               Dir.glob("#{ROOT}/build/ios/ipa/*.ipa").first,
      skip_waiting_for_build_processing: true,
      changelog:                         "#{version_name}+#{build_num}",
    )

    UI.success("✅ #{version_name}+#{build_num} uploaded to TestFlight")
  end

  desc "Build and submit to App Store for review"
  lane :release do
    setup_ci if is_ci

    match(
      type:           "appstore",
      api_key:        asc_api_key,
      app_identifier: [BUNDLE_ID, "#{BUNDLE_ID}.MorphoWidget"],
      readonly:       true,
    )

    setup_signing
    plist = write_export_options

    sh "flutter build ipa --release --export-options-plist='#{plist}'"

    deliver(
      api_key:           asc_api_key,
      app_identifier:    BUNDLE_ID,
      ipa:               Dir.glob("#{ROOT}/build/ios/ipa/*.ipa").first,
      submit_for_review: true,
      automatic_release: false,
      force:             true,
      skip_screenshots:  true,
    )

    UI.success("✅ #{version_name} submitted to App Store")
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Android
# ─────────────────────────────────────────────────────────────────────────────

platform :android do

  desc "Build AAB and upload to Google Play internal track"
  lane :internal do
    build_num = resolve_build_number

    sh "flutter build appbundle --release --build-number=#{build_num}"

    upload_to_play_store(
      package_name:   BUNDLE_ID,
      track:          "internal",
      aab:            "build/app/outputs/bundle/release/app-release.aab",
      json_key_data:  ENV.fetch("GOOGLE_PLAY_JSON_KEY"),
      release_status: "completed",
    )

    UI.success("✅ #{version_name}+#{build_num} uploaded to Google Play internal")
  end

  desc "Promote the internal track build to production"
  lane :production do
    upload_to_play_store(
      package_name:     BUNDLE_ID,
      track:            "internal",
      track_promote_to: "production",
      json_key_data:    ENV.fetch("GOOGLE_PLAY_JSON_KEY"),
    )

    UI.success("✅ #{version_name} promoted to Google Play production")
  end
end
